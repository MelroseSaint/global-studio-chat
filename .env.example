# ============================================================================
# PureWire environment variables — complete reference
#
# Two places hold configuration, and a deploy fails if either is incomplete:
#
#   1. VERCEL (build-time, frontend) — VITE_* vars must exist in the Vercel
#      dashboard (Project → Settings → Environment Variables → Production) OR
#      in .env.production (which is tracked in git for the public values).
#      The build runs `npm run build` (Vite production), which inlines these
#      into the shipped bundle. VITE_* vars are PUBLIC — never put secrets
#      in them.
#
#   2. CONVEX (runtime, backend) — server-side vars are set with:
#          npx convex env set <NAME> <value>
#      and never leave the deployment. List them with `npx convex env list`.
#
# Copy nothing here verbatim — this file has placeholders only. Real values
# for local dev go in .env.local (gitignored, see Vite docs).
# ============================================================================

# ----------------------------------------------------------------------------
# FRONTEND — Vercel (build-time, public)
# ----------------------------------------------------------------------------

# Convex backend URL. REQUIRED — the app cannot boot without it.
# In Vercel: VITE_CONVEX_URL = https://outgoing-seal-727.convex.cloud
# (already committed in .env.production so builds always have it.)
#
# NOTE on precedence: Vite production builds load .env, .env.local, then
# .env.production (later wins). Because .env.production is tracked with the
# production URL, local `npm run build` also points at production. To build
# against a different deployment locally, create .env.production.local.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Public site URL (canonical links / share metadata). The repo defaults this
# to the production host in vite.config.ts (the siteUrl plugin) — set it only
# when a custom domain lands. VITE_SITE_URL is no longer read anywhere: a
# stale dashboard var under that name used to override this and ship the
# wrong host in the canonical/OG tags.
PUREWIRE_SITE_URL=https://your-site.example.com

# Cloudflare Turnstile site key. OPTIONAL — when empty the human-check widget
# is hidden and the bot gate is off. When enabled, you MUST also set
# TURNSTILE_SECRET_KEY on Convex. Set the real key in the Vercel dashboard,
# never in a committed file.
VITE_TURNSTILE_SITE_KEY=

# ----------------------------------------------------------------------------
# BACKEND — Convex (runtime, secret)
# Set with: npx convex env set <NAME> <value>
# ----------------------------------------------------------------------------

# Resend API key for email delivery (verification + reset codes).
# REQUIRED for signup/sign-in/forgot-password emails to send. Get one at
# resend.com → API Keys (starts with re_), set it on Convex:
#   npx convex env set RESEND_API_KEY re_...
RESEND_API_KEY=

# Sender address for PureWire emails. The domain must be verified in the
# Resend dashboard (Domains). Defaults to PureWire <noreply@purewire.com>
# when unset — note the sandbox sender onboarding@resend.dev can only send
# to your own inbox, so verify a real domain for production.
EMAIL_FROM=

# NOTE: CONVEX_SITE_URL is BUILT-IN — Convex injects your deployment's
# site URL automatically and rejects overriding it (EnvVarNameForbidden).
# Leave it unset. It is the provider domain for Convex auth and the JWT
# issuer for QA sessions, and must match where the app is served.
# CONVEX_SITE_URL=https://your-site.example.com

# Long random hex salt for email hashing. REQUIRED in production — without a
# salt, email hashes degrade to unsalted SHA-256 (privacy falls back).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_HASH_SALT=

# Cloudflare Turnstile SECRET key (server-side verify). REQUIRED only if you
# enable VITE_TURNSTILE_SITE_KEY. Not used otherwise.
TURNSTILE_SECRET_KEY=

# SITE_URL is an alias fallback for CONVEX_SITE_URL in a few server paths.
# NOTE: on the production deployment this currently points at the Convex
# static host (outgoing-seal-727.convex.site), so email links resolve there.
# The canonical/SEO host is separate and repo-owned (PUREWIRE_SITE_URL).
SITE_URL=

# ----------------------------------------------------------------------------
# QA HARNESS — Convex, DISABLED in production on purpose
# The shadowban QA check (npm run qa:shadowban) is inert unless these are set.
# Never enable them on a production deployment except during a QA run, and
# remove them right after. See src/convex/testHarness.ts.
# ----------------------------------------------------------------------------
TEST_HARNESS_ENABLED=
TEST_HARNESS_SECRET=
# JWT_PRIVATE_KEY / JWKS are auto-provisioned by the Convex auth library on
# the deployment — do not set these manually.

# ----------------------------------------------------------------------------
# MEDIA STORAGE — Cloudinary (runtime, secret) — OPTIONAL but recommended
# Set with: npx convex env set <NAME> <value>
#
# PureWire media is dual-mode. When these vars are configured, the browser
# uploads photos/videos/audio straight to Cloudinary via an UNSIGNED upload
# preset and Convex stores only the tiny secure_url + public_id — so thousands
# of uploads never consume Convex's file-storage quota. When the vars are
# missing, media falls back to Convex's built-in storage (nothing breaks).
#
# The cloud name is public (it appears in every media URL) and safe to commit;
# the API key/secret are credentials and must stay in the deployment env, never
# in this file. Signing mode of the preset MUST be 'Unsigned' — the browser
# cannot hold your API secret.
#
#   CLOUDINARY_CLOUD_NAME        your cloud name (e.g. saintscloud)
#   CLOUDINARY_UPLOAD_PRESET     an UNSIGNED upload preset (dashboard:
#                                Settings → Upload → Upload presets →
#                                Add preset → Signing mode: Unsigned)
#   CLOUDINARY_API_KEY           API key (signed deletes + video re-uploads)
#   CLOUDINARY_API_SECRET        API secret (never sent to the browser)
CLOUDINARY_CLOUD_NAME=saintscloud
CLOUDINARY_UPLOAD_PRESET=purewire_unsigned
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEMBLE_API_KEY=
