{
  "name": "purewire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node -e \"const{cpSync,chmodSync,existsSync,mkdirSync}=require('fs');if(existsSync('.githooks/pre-push')){mkdirSync('.git/hooks',{recursive:true});cpSync('.githooks/pre-push','.git/hooks/pre-push');try{chmodSync('.git/hooks/pre-push',0o755)}catch(_){}}\"",
    "icons": "node scripts/generate-icons.mjs",
    "data:sync": "node scripts/sync-blocklist-data.mjs",
    "qa:shadowban": "node scripts/shadowban-qa.mjs",
    "qa:phishing": "node scripts/phishing-qa.mjs",
    "qa:blocklist": "node scripts/blocklist-qa.mjs",
    "qa:follows": "node scripts/follows-e2e.mjs",
    "qa:reinstate": "node scripts/reinstate-qa.mjs",
    "qa:salt": "node scripts/salt-rotation-qa.mjs",
    "qa:video-privacy": "node scripts/video-privacy-qa.mjs",
    "qa:prod-pipeline": "node scripts/prod-pipeline-verify.mjs",
    "qa:admin-auth": "node scripts/admin-auth-qa.mjs",
    "qa:admin-auth-browser": "node scripts/admin-auth-browser-qa.mjs",
    "qa:admin-responsive": "node scripts/qa-admin-responsive.mjs",
    "qa:signup-e2e": "node scripts/signup-e2e-prod.mjs",
    "qa:cloudinary-health": "node scripts/cloudinary-health-probe.mjs",
    "qa:extend-sessions": "node scripts/extend-sessions.mjs",
    "qa:session-lifetime": "node scripts/session-lifetime-qa.mjs",
    "qa:session-audit": "node scripts/session-audit.mjs",
    "qa:secrets": "node scripts/secrets-scan.mjs",
    "turnstile:keys": "node scripts/set-turnstile-keys.mjs",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run deploy:backend && npm run upload:version && npm run deploy:web",
    "deploy:backend": "npx convex deploy",
    "deploy:web": "npx vercel --prod",
    "upload:version": "npm run build && node scripts/upload-static-sync.mjs --prod",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.90",
    "@convex-dev/static-hosting": "^0.2.1",
    "@tailwindcss/vite": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.30.0",
    "framer-motion": "^12.23.25",
    "jose": "^5.10.0",
    "lucide-react": "^0.555.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-intersection-observer": "^10.0.0",
    "react-router": "^7.10.0",
    "resend": "^6.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "^7.2.6"
  }
}
