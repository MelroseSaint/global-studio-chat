# PureWire production environment — this file IS tracked in git on purpose.
# It holds only PUBLIC client config (VITE_* vars are baked into the shipped
# bundle, so they are not secrets). Server-side secrets live on the Convex
# deployment (`npx convex env set`) and in the Vercel dashboard — never here.

# Public Convex backend URL — required for the frontend to talk to the API.
# Without this the app cannot boot. Set via `npx convex env set VITE_CONVEX_URL`
# locally; it is committed here so Vercel production builds always have it.
VITE_CONVEX_URL=https://outgoing-seal-727.convex.cloud

# Public site URL (used for canonical links / share metadata).
VITE_SITE_URL=https://outgoing-seal-727.convex.site

# Cloudflare Turnstile site key. Public by design — it ships in the client
# bundle, so committing it here is safe. Optional: when empty, the widget is
# hidden and the bot gate is disabled. When you enable it, pair it with
# TURNSTILE_SECRET_KEY on Convex (npx convex env set TURNSTILE_SECRET_KEY …)
# or the gate fails closed. Set it here with: npm run turnstile:keys
VITE_TURNSTILE_SITE_KEY=
