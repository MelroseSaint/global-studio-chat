# Public site URL used for SEO canonical / Open Graph meta (Vite replaces
# %VITE_SITE_URL% in index.html at build time). Set this to the final Vercel
# URL after the first deploy (e.g. https://your-project.vercel.app) and to a
# custom domain once connected.
VITE_SITE_URL=https://purewire.vercel.app
